{
  "scene": "Sink", "size": [1280, 720], "fps": 25, "duration": 50, "background": null, "quality": "final",
  "controls": {"accent": "#FF4B2B", "spin": 30, "pad": 24},
  "textStyles": {"body": {"font": "Helvetica Neue", "style": "Regular", "size": 32, "color": "#FFFFFF"}},
  "layers": [
    {"id": "plate", "type": "solid", "size": [1280, 720], "color": "#202020"},
    {"id": "grad", "type": "rect", "size": [400, 200], "radius": "$pad", "position": [300, 200],
     "fill": {"gradient": {"type": "radial", "from": [200, 100], "to": [400, 100], "stops": [[0, "#FFFFFF"], [0.5, "#FF0000"], [1, "#000000"]]}},
     "effects": [{"type": "glow", "radius": 12, "strength": 0.6}, {"type": "tint", "color": "#88CCFF", "amount": 50}]},
    {"id": "img", "type": "image", "src": "tests/scenes/tile.png", "size": [320, 200], "position": [900, 200], "rotation": 12, "anchor": [0, 0], "opacity": "$spin"},
    {"id": "rig", "type": "null", "position": [640, 500], "keys": {"rotation": [[0, 0], [49, 90, "ease"]]}},
    {"id": "orbit", "type": "ellipse", "size": [60, 60], "fill": "$accent", "position": [200, 0], "parent": "rig"},
    {"id": "squash", "type": "rect", "size": [100, 100], "fill": "#00FF88", "position": [1100, 500],
     "keys": {"scale": [[0, [100, 100]], [20, [140, 70], "out_back"], [40, [100, 100]]]}},
    {"id": "wipe", "type": "rect", "size": [600, 300], "position": [640, 360], "fill": "#FFFFFF", "opacity": 0},
    {"id": "masked", "type": "text", "text": {"content": "Masked\nand matted", "textStyle": "body", "leading": 40}, "position": [400, 380],
     "masks": [{"shape": "ellipse", "box": [-20, -60, 300, 120], "feather": 6}, {"shape": "rect", "box": [0, -40, 80, 40], "mode": "subtract"}],
     "matte": {"layer": "wipe", "mode": "lumaInverted"}, "blend": "screen",
     "animators": [{"type": "typewriter", "start": 5, "end": 30, "mode": "fade"}]},
    {"id": "roll", "type": "rect", "size": [80, 80], "radius": 8, "fill": "#FFDD00", "position": [100, 650], "rotation": {"expr": "time*$spin/10", "value": 0},
     "stroke": {"color": "#000000", "width": 3, "join": "round"}, "repeat": {"count": 5, "offset": [120, 0], "rotation": 10},
     "effects": [{"type": "shadow", "offset": [6, 6], "blur": 8, "opacity": 50}, {"type": "blur", "radius": 2}, {"type": "grain", "strength": 0.02}]},
    {"id": "draw", "type": "path", "points": [{"p": [0, 0], "out": [60, -80]}, {"p": [300, 0], "in": [-60, -80], "out": [60, 80]}, {"p": [600, 0], "in": [-60, 80]}],
     "closed": false, "fill": null, "stroke": {"color": "$accent", "width": 6, "cap": "round"}, "position": [340, 620],
     "keys": {"trimEnd": [[0, 0], [30, 100, "in_out"]], "opacity": [[40, 100], [49, 0]]}},
    {"id": "grid", "type": "group", "layout": {"type": "grid", "columns": 3, "gap": 12}, "align": {"x": "right", "y": "top", "to": "safe"},
     "stagger": {"each": 2, "order": "center", "enter": "pop"},
     "layers": [{"id": "g1", "type": "rect", "size": [40, 40], "fill": "#FFFFFF"}, {"id": "g2", "type": "rect", "size": [40, 40], "fill": "#FFFFFF"},
                {"id": "g3", "type": "rect", "size": [40, 40], "fill": "#FFFFFF"}, {"id": "g4", "type": "ellipse", "size": [40, 40], "fill": "#FFFFFF"},
                {"id": "g5", "type": "ellipse", "size": [40, 40], "fill": "#FFFFFF"}]},
    {"id": "cam", "type": "camera", "lens": 35, "poi": null, "position": [640, 360, -1100], "keys": {"rotationY": [[0, -5], [49, 5]]}},
    {"id": "sun", "type": "light", "light": "point", "position": [640, 100, -400], "color": "#FFEEDD", "intensity": 120},
    {"id": "amb", "type": "light", "light": "ambient", "intensity": 30},
    {"id": "hang", "type": "null", "threeD": true, "position": [640, 360, 200], "anchor": [0, 0, 0], "keys": {"rotationY": [[0, 0], [49, 60]]}},
    {"id": "lit_card", "type": "rect", "size": [300, 180], "fill": "#DDDDDD", "position": [-200, 0, 0], "parent": "hang", "lit": true, "threeD": true},
    {"id": "tilt", "type": "text", "text": {"content": "Depth", "textStyle": "body", "size": 90}, "position": [200, 0, 0], "parent": "hang",
     "rotationX": 10, "anchor": [0, -30], "threeD": true, "keys": {"scale": [[0, 80], [30, 100]]}},
    {"id": "caption", "type": "text", "text": {"content": "kitchen sink", "textStyle": "body"}, "align": "bottom", "exit": {"preset": "fadeOutDown", "at": 40}}
  ],
  "grain": {"strength": 0.01, "size": 1.2, "mono": false}
}
