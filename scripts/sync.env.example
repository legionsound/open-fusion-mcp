# Copy to scripts/sync.local.env (git-ignored) and point at your checkouts.
CONNECTOR_SRC="$HOME/path/to/fusion-connector"   # the live connector (fusion_connector/, bin/, tests/)
SKILLS_SRC="$HOME/path/to/skills"                # folder holding fusion-motion-design, fusion-reference, ...
AGENTS_SRC="$HOME/.claude/agents"                # optional: example agent definitions
PYTHON="$HOME/path/to/fusion-connector/.venv/bin/python"   # Python 3.12 with requirements.txt installed
